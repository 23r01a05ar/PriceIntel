# =========================================================================
# PriceIntel v2.0 - Local Environment Variables Template
# =========================================================================
# Rename this file to '.env' inside the backend folder and populate it 
# with your actual secrets. Do NOT commit your populated '.env' to Git.

# -------------------------------------------------------------------------
# Flask Configuration
# -------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_flask_secret_key_here

# -------------------------------------------------------------------------
# API Keys (External Integrations)
# -------------------------------------------------------------------------

# RapidAPI Global Configuration (Fallback key for Amazon, Walmart, Flipkart)
RAPIDAPI_KEY=your_rapidapi_key_here

# RapidAPI Service-Specific Keys (Optional: fallback to RAPIDAPI_KEY if unset)
AMAZON_API_KEY=your_amazon_rapidapi_key_here
WALMART_API_KEY=your_walmart_rapidapi_key_here
FLIPKART_API_KEY=your_flipkart_rapidapi_key_here

# SerpAPI Configuration
SERPAPI_KEY=your_serpapi_key_here

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# -------------------------------------------------------------------------
# Database Configuration (Optional - Defaults to local SQLite)
# -------------------------------------------------------------------------
# DATABASE_URL=sqlite:///price_intelligence.db
